{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpo-today",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/data/*"]
  },
  "observability": { "enabled": true },
  "workers_dev": true
}
